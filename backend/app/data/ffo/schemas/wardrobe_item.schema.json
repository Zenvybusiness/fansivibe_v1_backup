{"$id": "https://fansivibe.local/ffo/v1/wardrobe_item.schema.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": true, "description": "FFO v1.0 wardrobe item. Mirror of the wardrobe_items row: category/color/material reference canonical codes; user_rating is the only user-owned field. Owner scoping (OW-1) is enforced by the API, not this schema.", "properties": {"aesthetic": {"items": {"type": "string"}, "type": "array"}, "brand": {"type": "string"}, "category": {"description": "FK RESTRICT to wardrobe_categories (0005).", "enum": ["tops", "bottoms", "outerwear", "footwear", "accessories"], "type": "string"}, "color": {"description": "Color code refs colors table; array allows multi-color items.", "items": {"type": "string"}, "type": "array"}, "condition": {"type": "string"}, "fit": {"type": "string"}, "item_id": {"type": "string"}, "material": {"description": "Material code refs materials table.", "items": {"type": "string"}, "type": "array"}, "occasion": {"description": "Occasion codes; canonical 9 are DB-backed.", "items": {"type": "string"}, "type": "array"}, "pattern": {"items": {"type": "string"}, "type": "array"}, "provenance": {"$ref": "#/$defs/provenance"}, "season": {"items": {"type": "string"}, "type": "array"}, "silhouette": {"type": "string"}, "subcategory": {"type": "string"}, "user_rating": {"type": ["number", "null"]}}, "required": ["category", "subcategory", "color"], "title": "FFO Wardrobe Item", "type": "object", "$defs": {"provenance": {"additionalProperties": true, "properties": {"confidence": {"maximum": 1, "minimum": 0, "type": "number"}, "created_at": {"format": "date-time", "type": "string"}, "source": {"type": "string"}, "source_type": {"enum": ["AUTHORITATIVE", "PROFESSIONAL", "INDUSTRY", "COMMUNITY", "INFERRED", "MODEL_GENERATED"], "type": "string"}, "updated_at": {"format": "date-time", "type": "string"}, "verified_at": {"format": "date-time", "type": ["string", "null"]}}, "type": "object"}}, "x-ffo-version": "1.0"}
