{"$id": "https://fansivibe.local/ffo/v1/outfit.schema.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": true, "description": "FFO v1.0 outfit. A graph, not a list; relationships (pairs_with, balances, ...) live in knowledge/relationships. Compatibility is per-dimension (color/silhouette/occasion/user_preference), never one fashion-correctness score.", "properties": {"accessories": {"items": {"type": "string"}, "type": "array"}, "bag": {"type": "string"}, "bottom": {"type": "string"}, "compatibility": {"description": "Per-dimension scores 0..1, e.g. color, silhouette, occasion, user_preference.", "type": "object"}, "footwear": {"type": "string"}, "grooming": {"type": "string"}, "hair": {"type": "string"}, "jewelry": {"items": {"type": "string"}, "type": "array"}, "makeup": {"type": "string"}, "outerwear": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}, "top": {"type": "string"}}, "title": "FFO Outfit", "type": "object", "$defs": {"provenance": {"additionalProperties": true, "properties": {"confidence": {"maximum": 1, "minimum": 0, "type": "number"}, "created_at": {"format": "date-time", "type": "string"}, "source": {"type": "string"}, "source_type": {"enum": ["AUTHORITATIVE", "PROFESSIONAL", "INDUSTRY", "COMMUNITY", "INFERRED", "MODEL_GENERATED"], "type": "string"}, "updated_at": {"format": "date-time", "type": "string"}, "verified_at": {"format": "date-time", "type": ["string", "null"]}}, "type": "object"}}, "x-ffo-version": "1.0"}
