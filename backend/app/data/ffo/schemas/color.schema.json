{"$id": "https://fansivibe.local/ffo/v1/color.schema.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": true, "description": "FFO v1.0 color. Never a bare name: hue/saturation/brightness/temperature/intensity/finish/semantic_family. Existing colors-table codes (17) remain the DB-valid subset; FFO names are the extensible superset.", "properties": {"brightness": {"type": "number"}, "finish": {"type": "string"}, "hue": {"type": "string"}, "intensity": {"type": "string"}, "name": {"description": "E.g. burgundy, olive, sage, emerald. Free string; DB FK subset is the 17 canonical codes.", "type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}, "relationships": {"description": "Color relationships, e.g. COMPLEMENTARY, ANALOGOUS, NEUTRAL, EARTH_TONE.", "items": {"type": "string"}, "type": "array"}, "saturation": {"type": "number"}, "semantic_family": {"type": "string"}, "temperature": {"type": "string"}}, "required": ["name"], "title": "FFO Color", "type": "object", "$defs": {"provenance": {"additionalProperties": true, "properties": {"confidence": {"maximum": 1, "minimum": 0, "type": "number"}, "created_at": {"format": "date-time", "type": "string"}, "source": {"type": "string"}, "source_type": {"enum": ["AUTHORITATIVE", "PROFESSIONAL", "INDUSTRY", "COMMUNITY", "INFERRED", "MODEL_GENERATED"], "type": "string"}, "updated_at": {"format": "date-time", "type": "string"}, "verified_at": {"format": "date-time", "type": ["string", "null"]}}, "type": "object"}}, "x-canonical-codes": ["black", "white", "navy", "charcoal", "grey", "beige", "burgundy", "olive", "khaki", "cream", "light_blue", "blush", "tan", "silver", "gold", "indigo", "stone"], "x-canonical-source": "colors.code (migration 0005)", "x-ffo-version": "1.0"}
