{"$defs": {"provenance": {"additionalProperties": true, "properties": {"confidence": {"maximum": 1, "minimum": 0, "type": "number"}, "created_at": {"format": "date-time", "type": "string"}, "source": {"type": "string"}, "source_type": {"enum": ["AUTHORITATIVE", "PROFESSIONAL", "INDUSTRY", "COMMUNITY", "INFERRED", "MODEL_GENERATED"], "type": "string"}, "updated_at": {"format": "date-time", "type": "string"}, "verified_at": {"format": "date-time", "type": ["string", "null"]}}, "required": ["source", "source_type", "confidence"], "type": "object"}}, "$id": "https://fansivibe.local/ffo/v1/knowledge_document.schema.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": true, "allOf": [{"if": {"properties": {"doc_type": {"const": "term"}}}, "then": {"required": ["entity_kind", "canonical_id", "payload"]}}, {"if": {"properties": {"doc_type": {"const": "alias"}}}, "then": {"required": ["canonical_id", "alias"]}}, {"if": {"properties": {"doc_type": {"const": "relationship"}}}, "then": {"required": ["rel_type", "subject", "object"]}}, {"if": {"properties": {"doc_type": {"const": "rule"}}}, "then": {"required": ["payload"]}}], "description": "FFO Phase 2A knowledge-document envelope (declarative contract; enforced at runtime by app.data.ffo.corpus structural checks, not a full JSON Schema engine). Authority tier is provenance.source_type (single field, no duplicate). doc_id slugs are unique; version starts at 1. Term payloads carry the FFO schema's required keys.", "properties": {"alias": {"description": "Variant name (alias docs only). Must resolve to a term canonical_id in the same load set.", "type": "string"}, "canonical_id": {"description": "Anchor entity id (required for term/alias; optional for relationship/rule).", "type": "string"}, "doc_id": {"description": "Stable slug, unique per document.", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$", "type": "string"}, "doc_type": {"enum": ["term", "alias", "relationship", "rule"], "type": "string"}, "entity_kind": {"description": "Registered FFO schema name the payload validates against (required for term).", "type": "string"}, "language": {"description": "BCP-47-ish code, e.g. en, en-IN.", "type": "string"}, "object": {"type": "string"}, "payload": {"type": "object"}, "provenance": {"$ref": "#/$defs/provenance"}, "published_at": {"format": "date-time", "type": "string"}, "region": {"type": "string"}, "rel_type": {"description": "Must be a relationship_types.json entry (relationship docs only).", "type": "string"}, "retrieved_at": {"format": "date-time", "type": "string"}, "status": {"enum": ["draft", "reviewed", "published", "deprecated"], "type": "string"}, "subject": {"type": "string"}, "version": {"description": "Per-document version, starts at 1. Files are the source of truth; same doc_id twice is always a duplicate.", "minimum": 1, "type": "integer"}}, "required": ["doc_id", "doc_type", "status", "version", "language", "provenance"], "title": "FFO Knowledge Document", "type": "object", "x-ffo-version": "1.0", "x-phase": "2A"}
