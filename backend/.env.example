# Fansivibe backend — EXAMPLE production environment (21.2).
#
# Copy to `.env` (NEVER commit `.env`) or inject each variable through
# your secret manager / container orchestrator. Every value below is a
# PLACEHOLDER — replace `<...>` before deploying. The service refuses
# to start in production with dev defaults (see settings.py).
#
# Labels: [REQUIRED] must be set, [CONDITIONAL] only when noted,
# [OPTIONAL] has a safe default.

# --- Core ---
FANSIVIBE_ENV=production
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
FANSIVIBE_AUTH_SECRET=<random-secret-at-least-32-chars>
FANSIVIBE_ALLOW_DEV_TOKEN=false
FANSIVIBE_ENABLE_DOCS=false
FANSIVIBE_CORS_ORIGINS=

# --- Rate limiting [OPTIONAL] (21.2 local guard for register/login) ---
FANSIVIBE_RATE_LIMIT_ENABLED=true
FANSIVIBE_RATE_LIMIT_AUTH_PER_MINUTE=60
FANSIVIBE_RATE_LIMIT_WINDOW_S=60

# --- Concurrency [OPTIONAL] (container workers; prefer replicas) ---
UVICORN_WORKERS=1
PORT=8000

# --- Vision / Ollama [CONDITIONAL] ---
# Option A — vision ENABLED (provision an Ollama host in Phase 21.3 first):
# FANSIVIBE_VISION_HOST=http://<ollama-host>:11434
# FANSIVIBE_VISION_MODEL=<vision-capable-model>
# FANSIVIBE_VISION_TIMEOUT_S=20
# FANSIVIBE_DISABLE_VISION=false
#
# Option B — vision DISABLED (scans fail closed, no fake AI results):
FANSIVIBE_DISABLE_VISION=true

# --- Fashion Reasoning / Ollama [CONDITIONAL / PRODUCTION] ---
# Host and model configuration for FFO fashion reasoning pipeline
FANSIVIBE_OLLAMA_HOST=http://localhost:11434
FANSIVIBE_OLLAMA_MODEL=qwen2.5vl:3b
FANSIVIBE_REASONING_TIMEOUT_S=60.0
FANSIVIBE_REASONING_TEMPERATURE=0.0
FANSIVIBE_REASONING_MAX_RETRIES=1
FANSIVIBE_REASONING_CONCURRENCY_LIMIT=2
FANSIVIBE_REASONING_KEEP_ALIVE=15m
FANSIVIBE_RATE_LIMIT_REASONING_PER_MINUTE=30
FANSIVIBE_DISABLE_REASONING=false

# --- External Integrations [OPTIONAL] ---
# Optional YouTube Data API v3 key. Empty or whitespace-only values are treated as unset.
# NEVER commit a real API key to version control or shared environments.
YOUTUBE_DATA_API_KEY=

# --- E-Commerce Product Ingestion (DISCOVERY-10B-4) [OPTIONAL] ---
# Option A — Amazon India Product Advertising API 5.0 (PA-API 5.0):
# Requires active Associate account (affiliate-program.amazon.in) with >= 3 referred sales in 180 days.
AMAZON_ASSOCIATE_TAG=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_REGION=eu-west-1

# Option B — Rainforest API (Commercial Amazon.in Catalog & Search Proxy):
# Bootstrap fallback providing structured Amazon.in product data without 3-sale gatekeeping.
RAINFOREST_API_KEY=
